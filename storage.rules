rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: only the user can upload/delete their own photo
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Material files: any authenticated user can upload
    // (ownership is enforced via the material document in Firestore)
    match /materiales/{materialId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
