rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return firestore.exists(
        /databases/(default)/documents/users/$(request.auth.uid)
      ) && firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data.role == 'admin';
    }

    // ─── MATERIAL FILES ───
    // Only authenticated users can upload
    // Max file size: 10 MB
    // Only PDF, PNG, JPG, JPEG, WebP allowed
    // Only the owner can upload/delete (admins can also delete)
    match /materials/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuth()
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/png', 'image/jpeg', 'image/webp'];
      allow delete: if isAuth()
        && (request.auth.uid == userId || isAdmin());
    }

    // ─── PROFILE PHOTOS ───
    // Max 2 MB, only images
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuth()
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuth()
        && (request.auth.uid == userId || isAdmin());
    }

    // ─── ADMIN FULL ACCESS ───
    // Admins can manage all files
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuth() && isAdmin();
      allow delete: if isAuth() && isAdmin();
    }
  }
}
