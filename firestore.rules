rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if the requesting user owns the document
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Helper: check if only download count changed (allowed for any auth user)
    function onlyDownloadsChanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() == 1 && changed.has('downloads');
    }

    // Helper: check if only averageRating or ratingsCount changed
    function onlyRatingChanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let allowed = changed.has('averageRating') || changed.has('ratingsCount');
      return changed.size() <= 2 && allowed;
    }

    // Helper: check if user is in the conversation's users array
    function isParticipant() {
      return isAuth() && resource.data.users.hasAny([request.auth.uid]);
    }

    // ─── users ───
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ─── materials ───
    match /materials/{materialId} {
      allow read: if true;
      allow create: if isAuth();
      // any auth user can increment download count; owner can edit everything
      allow update: if isAuth()
        && (resource.data.creatorId == request.auth.uid || onlyDownloadsChanged() || onlyRatingChanged());
      allow delete: if isAuth() && resource.data.creatorId == request.auth.uid;
    }

    // ─── materialComments ───
    match /materialComments/{commentId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── materialRatings ───
    match /materialRatings/{ratingId} {
      allow read: if true;
      // userId must match the authenticated user (prevents rating on behalf of others)
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── forumPosts ───
    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;

      // ── subcollection: comments ──
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth();
        allow update: if isAuth() && resource.data.userId == request.auth.uid;
        allow delete: if isAuth() && resource.data.userId == request.auth.uid;
      }
    }

    // ─── conversations ───
    match /conversations/{conversationId} {
      allow read: if isParticipant();
      allow create: if isAuth();
      // participants can update (lastRead, lastMessage)
      allow update: if isParticipant();
      allow delete: if false; // no one deletes conversations

      // ── subcollection: messages ──
      match /messages/{messageId} {
        allow read: if isParticipant();
        allow create: if isParticipant();
        allow update: if isAuth() && resource.data.senderId == request.auth.uid;
        allow delete: if isAuth() && resource.data.senderId == request.auth.uid;
      }
    }

    // ─── notifications ───
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // favorites are stored as an array on the user document (users/{userId}/favorites)
  }
}
