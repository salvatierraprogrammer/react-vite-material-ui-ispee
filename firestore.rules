rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isModerator() {
      return isAuth()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderador'];
    }

    // ─── USERS ───
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ─── MATERIALS ───
    match /materials/{materialId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.fileSize <= 10 * 1024 * 1024;
      allow update: if isAuth()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuth()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── MATERIAL COMMENTS ───
    match /materialComments/{commentId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth()
        && (resource.data.userId == request.auth.uid || isModerator());
    }

    // ─── MATERIAL RATINGS ───
    match /materialRatings/{ratingId} {
      allow read: if true;
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ─── FORUM POSTS ───
    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth()
        && (resource.data.userId == request.auth.uid || isModerator());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth();
        allow update: if isAuth() && resource.data.userId == request.auth.uid;
        allow delete: if isAuth()
          && (resource.data.userId == request.auth.uid || isModerator());
      }
    }

    // ─── CONVERSATIONS ───
    match /conversations/{conversationId} {
      allow read: if isAuth()
        && resource.data.users.hasAny([request.auth.uid]);
      allow create: if isAuth();
      allow update: if isAuth()
        && resource.data.users.hasAny([request.auth.uid]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuth()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.users.hasAny([request.auth.uid]);
        allow create: if isAuth()
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.users.hasAny([request.auth.uid]);
        allow update: if isAuth() && resource.data.senderId == request.auth.uid;
        allow delete: if isAuth() && resource.data.senderId == request.auth.uid;
      }
    }

    // ─── NOTIFICATIONS ───
    match /notifications/{notificationId} {
      allow read: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ─── ADMIN COLLECTIONS (solo admins) ───
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /adminAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /sanctions/{sanctionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
